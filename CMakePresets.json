{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {"OPENIEC61850_BUILD_TESTS": "ON"}
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Debug with tests",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "OPENIEC61850_ENABLE_TLS": "ON"}
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release with tests",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "OPENIEC61850_ENABLE_TLS": "ON"}
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Debug with ASan + UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OPENIEC61850_SANITIZERS": "address;undefined",
        "OPENIEC61850_WARNINGS_AS_ERRORS": "ON",
        "OPENIEC61850_ENABLE_TLS": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "libFuzzer fuzzers (clang)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "OPENIEC61850_SANITIZERS": "address;undefined",
        "OPENIEC61850_BUILD_FUZZERS": "ON",
        "OPENIEC61850_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "bench",
      "inherits": "base",
      "displayName": "Release benchmarks (Google Benchmark)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPENIEC61850_BUILD_BENCHMARKS": "ON",
        "OPENIEC61850_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {"name": "dev", "configurePreset": "dev"},
    {"name": "release", "configurePreset": "release"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "fuzz", "configurePreset": "fuzz"},
    {"name": "bench", "configurePreset": "bench"}
  ],
  "testPresets": [
    {"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}}
  ]
}
