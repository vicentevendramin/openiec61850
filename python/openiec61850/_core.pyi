"""openiec61850 native core (internal; use the openiec61850 package).

Generated with ``python -m nanobind.stubgen -m openiec61850._core`` and refined by hand. MMS Data
travels as tagged tuples (see python/src/convert.hpp); object references as their string form.
Failed operations raise the exception built by the error factory from (category, value,
message, details), where details is None or a dict with error_class, error_code,
additional_code, additional_description, modifier_position, reject_type, reject_reason,
original_invoke_id and last_appl_error.
"""

import asyncio
from collections.abc import Callable, Iterable, Mapping
from typing import Any

__version__: str

Tagged = tuple[Any, ...]

class _Deferred:
    """A finished native operation (internal)."""

def _complete(future: asyncio.Future[Any], box: _Deferred) -> None: ...
def _set_error_factory(factory: Callable[[str, int, str, dict[str, Any] | None], BaseException]) -> None: ...
def _shutdown() -> None: ...
def _runtime_running() -> bool: ...
def _roundtrip(value: Tagged) -> Tagged: ...
def _encode(value: Tagged) -> bytes: ...
def parse_reference(
    text: str, edition: int = 2, strict_ln_names: bool = True
) -> tuple[str, str, str, list[tuple[str, int | None]], str | None, bool]:
    """Validates an object reference; returns (text, ld, ln, path, fc, association_specific)."""

def split_ln_name(ln: str) -> tuple[str, str, str] | None: ...
def to_mms_reference(text: str, edition: int = 2) -> str: ...
def from_mms_reference(text: str, edition: int = 2, strict_ln_names: bool = False) -> str: ...
def from_mms_data_reference(text: str, edition: int = 2, strict_ln_names: bool = False) -> str: ...
def to_mms_data_set_reference(text: str, edition: int = 2) -> str: ...
