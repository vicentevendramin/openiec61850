    def logical_devices(self) -> list[int]: ...
    def node(
        self, id: int
    ) -> tuple[str, str, int | None, list[int], str | None, str | None, int, int, tuple[bool, bool, bool]]:
        """(name, kind, parent, children, fc, basic_type, size, count, (dchg, qchg, dupd))"""
    def initial_value(self, id: int) -> Tagged | None: ...
    def reference_of(self, id: int) -> str: ...
    def find(self, ref: str) -> int | None: ...
    def definition(self, ref: str) -> Definition: ...
    def node_definition(self, id: int, fc: str | None = None) -> Definition: ...
    def data_sets(self) -> list[tuple[str, str, list[str]]]: ...
    def report_controls(self) -> list[dict[str, Any]]: ...
