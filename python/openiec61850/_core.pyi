        """settings: dat_set, trg_ops (raw), intg_pd, log_ena (None: not written)."""
    def query_log_by_time(
        self, log: str, start: tuple[int, int | None] | None, stop: tuple[int, int | None] | None
    ) -> asyncio.Future[list[tuple[bytes, tuple[int, int | None], list[tuple[str, Tagged, int | None]]]]]:
        """[(entry_id, (ms_of_day, days), [(reference, value, reason raw | None)])]"""
    def query_log_after(
        self, log: str, time: tuple[int, int | None], entry_id: bytes
    ) -> asyncio.Future[list[tuple[bytes, tuple[int, int | None], list[tuple[str, Tagged, int | None]]]]]: ...
    def log_status(self, log: str) -> asyncio.Future[int]: ...
    # files
    def file_directory(self, path: str = "") -> asyncio.Future[list[tuple[str, int, float | None]]]:
        """[(name, size, POSIX mtime | None)]"""
    def get_file(self, name: str) -> asyncio.Future[bytes]: ...
    def get_file_stream(self, name: str, on_chunk: Callable[[bytes], None]) -> asyncio.Future[int]:
        """on_chunk runs on the loop, in order, before the future resolves."""
    def set_file(self, name: str, content: bytes) -> asyncio.Future[None]: ...
    def set_file_stream(
        self, name: str, size: int, reader: Callable[[int, int], bytes], source_name: str = ""
    ) -> asyncio.Future[None]:
        """reader(offset, size) runs on the I/O thread while the server pulls the file."""
    def delete_file(self, name: str) -> asyncio.Future[None]: ...
    def rename_file(self, from_: str, to: str) -> asyncio.Future[None]: ...
    # GOOSE control blocks
    def gocb_values(self, gocb: str) -> asyncio.Future[dict[str, Any]]:
        """go_ena, go_id, dat_set, conf_rev, nds_com, dst_address ((mac, priority, vid, app_id) |
        None), min_time, max_time, fixed_offs."""
    def set_gocb_values(self, gocb: str, settings: Mapping[str, Any]) -> asyncio.Future[None]:
        """settings: go_id, dat_set, go_ena."""

