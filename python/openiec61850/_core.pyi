    def read_many(self, refs: Iterable[str]) -> asyncio.Future[list[tuple[bool, Any]]]: ...
    def write(self, ref: str, value: Tagged) -> asyncio.Future[None]: ...
    def write_many(self, items: Iterable[tuple[str, Tagged]]) -> asyncio.Future[list[BaseException | None]]: ...
    def data_set_directory(self, data_set: str) -> asyncio.Future[tuple[list[str], bool]]: ...
    def create_data_set(self, data_set: str, members: Iterable[str]) -> asyncio.Future[None]: ...
    def delete_data_set(self, data_set: str) -> asyncio.Future[None]: ...
    def data_set_values(self, data_set: str) -> asyncio.Future[list[tuple[bool, Any]]]: ...
    def set_data_set_values(
        self, data_set: str, values: Iterable[Tagged]
    ) -> asyncio.Future[list[BaseException | None]]: ...
    def rcb_values(self, rcb: str) -> asyncio.Future[dict[str, Any]]: ...
    def set_rcb_values(self, rcb: str, settings: Mapping[str, Any]) -> asyncio.Future[None]: ...
    def enable_reporting(self, rcb: str, settings: Mapping[str, Any]) -> asyncio.Future[dict[str, Any]]: ...
