class Server:
    """Native IEC 61850 server. Use openiec61850.Server."""

    @staticmethod
    def start(
        model: Model,
        host: str,
        port: int,
        options: Mapping[str, Any],
        on_write: Callable[[int, str, Tagged], int] | None,
        on_control: Callable[[dict[str, Any], _ControlCompletion], tuple[int, int]] | None,
        authorize: Callable[[dict[str, Any]], bool] | None,
        on_setting_group: Callable[[int, str, int, int], int] | None = None,
        on_goose_control: Callable[[int, dict[str, Any]], None] | None = None,
        on_obtain_file: Callable[[int, str, str], int] | None = None,
    ) -> Server:
        """options also take log_capacity, max_open_files, max_obtain_file_size,
        obtain_file_timeout and files (a FileStore, or an adapter with a writable attribute whose
        list / stat / read / write / remove / rename return (code, value), called on the I/O
        thread). on_obtain_file(association, source, destination) answers a negative number to
        accept or a file_errc value to refuse."""
    def stop(self) -> None: ...
    def wait_stopped(self) -> asyncio.Future[None]: ...
    @property
    def association_count(self) -> int: ...
    @property
    def local_endpoint(self) -> tuple[str, int]: ...
    def update(self, ref: str, value: Tagged, quality: int | None = None, timestamp: Tagged | None = None) -> None: ...
    def update_many(self, items: Iterable[tuple[str, Tagged, int | None, Tagged | None]]) -> None: ...
    def read(self, ref: str) -> asyncio.Future[Tagged]: ...
    def select_active_setting_group(self, ld: str, sg: int) -> None: ...
    def read_setting_group(self, ref: str, sg: int) -> asyncio.Future[Tagged]: ...
    def goose_control(self, ref: str) -> asyncio.Future[dict[str, Any]]: ...
    def goose_controls(self) -> asyncio.Future[list[dict[str, Any]]]: ...

FileInfoTuple = tuple[str, int, float | None]

class FileStore:
    """Native file store (memory or directory)."""

    @staticmethod
    def memory() -> FileStore: ...
    @staticmethod
    def directory(root: str) -> FileStore: ...
    @property
    def root(self) -> str | None: ...
    def put(self, path: str, content: bytes, mtime: float | None = None) -> None: ...
    def get(self, path: str) -> bytes | None: ...
    def list(self, directory: str = "") -> list[FileInfoTuple]: ...
    def stat(self, path: str) -> FileInfoTuple: ...
    def read(self, path: str, offset: int, size: int) -> bytes: ...
    def write(self, path: str, content: bytes) -> None: ...
    def remove(self, path: str) -> None: ...
    def rename(self, from_: str, to: str) -> None: ...

