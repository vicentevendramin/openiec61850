"""openiec61850 native core (internal; use the openiec61850 package).

Generated with ``python -m nanobind.stubgen -m openiec61850._core`` and refined by hand. MMS Data
travels as tagged tuples (see python/src/convert.hpp); object references as their string form.
Failed operations raise the exception built by the error factory from (category, value,
message, details), where details is None or a dict with error_class, error_code,
additional_code, additional_description, modifier_position, reject_type, reject_reason,
original_invoke_id and last_appl_error.
"""

import asyncio
from collections.abc import Callable, Iterable, Mapping
from typing import Any

__version__: str

Tagged = tuple[Any, ...]

class _Deferred:
    """A finished native operation (internal)."""

def _complete(future: asyncio.Future[Any], box: _Deferred) -> None: ...
def _set_error_factory(factory: Callable[[str, int, str, dict[str, Any] | None], BaseException]) -> None: ...
def _shutdown() -> None: ...
def _runtime_running() -> bool: ...
def _roundtrip(value: Tagged) -> Tagged: ...
def _encode(value: Tagged) -> bytes: ...
def parse_reference(
    text: str, edition: int = 2, strict_ln_names: bool = True
) -> tuple[str, str, str, list[tuple[str, int | None]], str | None, bool]:
    """Validates an object reference; returns (text, ld, ln, path, fc, association_specific)."""

def split_ln_name(ln: str) -> tuple[str, str, str] | None: ...
def to_mms_reference(text: str, edition: int = 2) -> str: ...
def from_mms_reference(text: str, edition: int = 2, strict_ln_names: bool = False) -> str: ...
def to_mms_data_set_reference(text: str, edition: int = 2) -> str: ...
def from_mms_data_set_reference(text: str, edition: int = 2, strict_ln_names: bool = False) -> str: ...
def to_mms_variable(text: str, edition: int = 2) -> tuple[int, str, str, bytes]:
    """MMS variable of a functionally constrained reference: (scope, domain, item, alternate access contents)."""

class Client:
    """Native ACSI client. Use openiec61850.Client instead; every service returns an asyncio future."""

    @staticmethod
    def connect(options: Mapping[str, Any]) -> asyncio.Future[Client]: ...
    def release(self) -> asyncio.Future[None]: ...
    def abort(self) -> None: ...
    def wait_closed(self) -> asyncio.Future[BaseException]: ...
    @property
    def state(self) -> str: ...
    @property
    def edition(self) -> int: ...
    def association_info(self) -> dict[str, Any]: ...
    def server_directory(self) -> asyncio.Future[list[str]]: ...
    def logical_device_directory(self, ld: str) -> asyncio.Future[list[str]]: ...
    def logical_node_directory(self, ln: str) -> asyncio.Future[dict[str, Any]]: ...
    def data_directory(self, ref: str) -> asyncio.Future[list[tuple[str, list[str]]]]: ...
    def data_definition(self, ref: str) -> asyncio.Future[dict[str, Any]]: ...
    def name_list(self, object_class: int, domain: str = "") -> asyncio.Future[list[str]]: ...
    def read(self, ref: str) -> asyncio.Future[Tagged]: ...
    def read_many(self, refs: Iterable[str]) -> asyncio.Future[list[tuple[bool, Any]]]: ...
    def write(self, ref: str, value: Tagged) -> asyncio.Future[None]: ...
    def write_many(self, items: Iterable[tuple[str, Tagged]]) -> asyncio.Future[list[BaseException | None]]: ...
    def data_set_directory(self, data_set: str) -> asyncio.Future[tuple[list[str], bool]]: ...
    def create_data_set(self, data_set: str, members: Iterable[str]) -> asyncio.Future[None]: ...
    def delete_data_set(self, data_set: str) -> asyncio.Future[None]: ...
    def data_set_values(self, data_set: str) -> asyncio.Future[list[tuple[bool, Any]]]: ...
    def set_data_set_values(
        self, data_set: str, values: Iterable[Tagged]
    ) -> asyncio.Future[list[BaseException | None]]: ...
    def rcb_values(self, rcb: str) -> asyncio.Future[dict[str, Any]]: ...
    def set_rcb_values(self, rcb: str, settings: Mapping[str, Any]) -> asyncio.Future[None]: ...
    def enable_reporting(self, rcb: str, settings: Mapping[str, Any]) -> asyncio.Future[dict[str, Any]]: ...
    def disable_reporting(self, rcb: str) -> asyncio.Future[None]: ...
    def trigger_gi(self, rcb: str) -> asyncio.Future[None]: ...
    def last_entry_id(self, rcb: str) -> bytes | None: ...
    def next_report(self) -> asyncio.Future[dict[str, Any]]: ...
    @property
    def reports_dropped(self) -> int: ...
    def next_event(self) -> asyncio.Future[dict[str, Any]]: ...
    def control(
        self,
        object: str,
        ctl_model: int | None = None,
        read_sbo_timeout: bool = True,
        read_structure: bool = True,
    ) -> asyncio.Future[Control]: ...
    def operate(self, object: str, value: Tagged, options: Mapping[str, Any] | None = None) -> asyncio.Future[None]:
        """options: origin (orCat, orIdent), test, synchro_check, interlock_check, oper_time
        (tagged utc-time), ctl_num, termination_timeout (seconds)."""

