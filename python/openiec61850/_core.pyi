        """The ctlVal type as a data definition dict (name, mms_type, basic_type, size, children)."""
    @property
    def last_error(self) -> tuple[str, int, tuple[int, bytes], int, int] | None:
        """(CntrlObj, Error, (orCat, orIdent), ctlNum, AddCause)."""
